# Copy to .env and export before starting (never commit real values).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

SONAR_ENABLED=false
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=

SNYK_ENABLED=false
SNYK_TOKEN=

# Pull requests (GitHub). Off by default.
GIT_PUSH_ENABLED=false
GITHUB_TOKEN=

# Optional shared secret for /api/** (send as X-API-Key)
AUTOREMEDIATE_API_KEY=
REMEDIATION_WORKSPACE=./work
